# Copy to .env next to app.js on the server and fill in. Never commit .env.
TELEGRAM_TOKEN=
# plusieurs clés possibles, séparées par des virgules : la suivante prend le relais si la première est bloquée
GEMINI_API_KEY=
# Optional: free backup model when Gemini is saturated (console.groq.com)
GROQ_API_KEY=
# Transcription du wolof (ElevenLabs Scribe) — fortement conseillé pour les vocaux en wolof
ELEVENLABS_API_KEY=
# Optional: set to false to stop sending a voice note after each answer
LAMP_VOICE_REPLY=true

# ── Mémoire des utilisateurs ──
# Dossier où sont gardées les conversations et la mémoire de chaque personne (par défaut : data/ du projet).
# Sur Railway : monter un volume, par exemple sur /data, et mettre LAMP_DATA_DIR=/data
LAMP_DATA_DIR=
# Optionnel : compte de service Firebase (texte JSON ou chemin du fichier) pour tout garder dans Firestore
FIREBASE_SERVICE_ACCOUNT=
# Page pour lire les conversations : http://<serveur>:<PORT>/admin  (identifiant : admin)
LAMP_ADMIN_PASSWORD=
PORT=8080
